# ─── Server ──────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=4000
# Public base URL shown in Swagger's "Servers" list (defaults to http://localhost:PORT)
API_PUBLIC_URL=http://localhost:4000

# ─── Database (Prisma + PostgreSQL) ──────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
# The database is created automatically by "npm run prisma:migrate" if missing.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quicktask?schema=public"

# ─── Security ────────────────────────────────────────────────────────────
# Comma-separated API keys (min 32 chars each). Clients send one in the
# "x-api-key" header. List several to rotate keys without downtime.
# Generate one with:
#   node -e "console.log('qt_'+require('crypto').randomBytes(32).toString('hex'))"
API_KEYS=replace-me-with-a-generated-key-of-at-least-32-chars

# Comma-separated browser origins allowed by CORS (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# Max JSON request body size.
JSON_BODY_LIMIT=100kb

# ─── Docs ────────────────────────────────────────────────────────────────
# Serve Swagger UI at /docs and /docs/tasks. Set to false to hide in production.
DOCS_ENABLED=true
