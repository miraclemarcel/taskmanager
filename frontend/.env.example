# Server-only settings for the Next.js proxy route (src/app/api/[...path]/route.ts).
# Do NOT prefix these with NEXT_PUBLIC_ — that would ship the API key to the browser.

# Base URL of the QuickTask backend (no trailing slash).
API_URL=http://localhost:4000

# One of the keys listed in the backend's API_KEYS variable.
API_KEY=paste-a-key-from-backend-API_KEYS-here
